local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

--------------------------------------------------
-- SAVE DEFAULT (RESET)
--------------------------------------------------
local DEFAULT = {
	FogStart = Lighting.FogStart,
	FogEnd = Lighting.FogEnd,
	FogColor = Lighting.FogColor,
	Brightness = Lighting.Brightness,
	GlobalShadows = Lighting.GlobalShadows,
	EnvDiff = Lighting.EnvironmentDiffuseScale,
	EnvSpec = Lighting.EnvironmentSpecularScale,
	OutdoorAmbient = Lighting.OutdoorAmbient
}

--------------------------------------------------
-- CORE: GRAY CLOUD + REMOVE TEXTURE
--------------------------------------------------
local function ApplyGray()
	Lighting.FogStart = 0
	Lighting.FogEnd = 300
	Lighting.FogColor = Color3.fromRGB(170,170,170)
	Lighting.Brightness = 1
	Lighting.GlobalShadows = false
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0
	Lighting.OutdoorAmbient = Color3.fromRGB(150,150,150)

	for _,v in ipairs(Workspace:GetDescendants()) do
		if v:IsA("Texture") or v:IsA("Decal") then
			v.Transparency = 1
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail")
		or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Beam") then
			v.Enabled = false
		end
	end
end

--------------------------------------------------
-- LOW POLY MODE
--------------------------------------------------
local function LowPoly()
	for _,v in ipairs(Workspace:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Material = Enum.Material.Plastic
			v.Reflectance = 0
			v.CastShadow = false
		end
	end
end

--------------------------------------------------
-- RESET GRAPHICS
--------------------------------------------------
local function ResetGraphics()
	Lighting.FogStart = DEFAULT.FogStart
	Lighting.FogEnd = DEFAULT.FogEnd
	Lighting.FogColor = DEFAULT.FogColor
	Lighting.Brightness = DEFAULT.Brightness
	Lighting.GlobalShadows = DEFAULT.GlobalShadows
	Lighting.EnvironmentDiffuseScale = DEFAULT.EnvDiff
	Lighting.EnvironmentSpecularScale = DEFAULT.EnvSpec
	Lighting.OutdoorAmbient = DEFAULT.OutdoorAmbient

	for _,v in ipairs(Workspace:GetDescendants()) do
		if v:IsA("Texture") or v:IsA("Decal") then
			v.Transparency = 0
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail")
		or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Beam") then
			v.Enabled = true
		elseif v:IsA("BasePart") then
			v.CastShadow = true
		end
	end
end

--------------------------------------------------
-- AUTO HOOK (DESCENDANT ADDED)
--------------------------------------------------
local autoHook = false
local hookConn

local function HookSpawn()
	if hookConn then hookConn:Disconnect() end
	hookConn = Workspace.DescendantAdded:Connect(function(v)
		if not autoHook then return end
		if v:IsA("Texture") or v:IsA("Decal") then
			v.Transparency = 1
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail")
		or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Beam") then
			v.Enabled = false
		elseif v:IsA("BasePart") then
			v.Material = Enum.Material.Plastic
			v.Reflectance = 0
			v.CastShadow = false
		end
	end)
end

