-- FPS COUNTER
------------------------------------------------
local fpsLabel = FPSTab:CreateLabel("FPS: ...")
local frames, last = 0, tick()

RunService.RenderStepped:Connect(function()
	frames += 1
	if tick() - last >= 1 then
		fpsLabel:Set("FPS: "..frames)
		frames = 0
		last = tick()
	end
end)

