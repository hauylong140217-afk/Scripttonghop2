   Name = "Evade | kencute24 Script Premium",
   LoadingTitle = "Evade Script Hub",
   LoadingSubtitle = "by KenCute",
   ConfigurationSaving = {Enabled = true, FolderName = "EvadeKenCute"},
   KeySystem = true,
   KeySettings = {
      Title = "Key System",
      Subtitle = "Enter Key",
      Note = "join discord in tiktok ken.cute24", 
      FileName = "EvadeKey",
      SaveKey = true,
      Key = {"keyrobloxevadekencute24"}
   }
})

-- Biến lưu giá trị logic
local _G = {
    Speed = 16,
    JumpCap = 50,
    FOV = 70,
    AntiAFK = false
}

--- TAB 1 & 2: NOTES ---
local Tab1 = Window:CreateTab("About")
Tab1:CreateParagraph({Title = "About", Content = ""}) -- Tự điền note của bạn

local Tab2 = Window:CreateTab("Update Log")
Tab2:CreateParagraph({Title = "Log", Content = "0.01 notworking"}) -- Tự điền note của bạn
Tab2:CreateParagraph({Title = "Log", Content = "0.02"}) -- Tự điền note của bạn

--- TAB 3: MAIN ---
local Tab3 = Window:CreateTab("Main")

Tab3:CreateToggle({
   Name = "ESP Nextbot",
   CurrentValue = false,
   Callback = function(Value)
      -- Logic ESP cơ bản (Ví dụ minh họa)
      _G.ESPNextbot = Value
      while _G.ESPNextbot do
          task.wait(1)
          for _, v in pairs(workspace.Game.Nextbots:GetChildren()) do
              if not v:FindFirstChild("Highlight") then
                  local hi = Instance.new("Highlight", v)
                  hi.FillColor = Color3.fromRGB(255, 0, 0)
              end
          end
      end
   end
})

-- Nút Reset (Đưa mọi thứ về mặc định)
Tab3:CreateButton({
   Name = "Reset to Default",
   Callback = function()
       game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16
       game.Players.LocalPlayer.Character.Humanoid.JumpPower = 50
       workspace.CurrentCamera.FieldOfView = 70
   end,
})

--- TAB 4: AUTO FARM ---
local Tab4 = Window:CreateTab("Auto Farm")
Tab4:CreateLabel("Warning! Only Use in Private server")
Tab4:CreateParagraph({Title = "How it works", Content = "Only enable one toggle at a time..."})

Tab4:CreateToggle({
   Name = "Anti AFK",
   CurrentValue = false,
   Callback = function(Value)
      _G.AntiAFK = Value
      if _G.AntiAFK then
          local VirtualUser = game:GetService("VirtualUser")
          game.Players.LocalPlayer.Idled:Connect(function()
              if _G.AntiAFK then
                  VirtualUser:CaptureController()
                  VirtualUser:ClickButton2(Vector2.new())
              end
          end)
      end
   end
})

--- TAB 5: ACTIONS ---
local Tab5 = Window:CreateTab("Actions")

Tab5:CreateSlider({
   Name = "Player Speed",
   Range = {16, 300},
   Increment = 1,
   CurrentValue = 16,
   Callback = function(Value)
      _G.Speed = Value
      game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
   end,
})

Tab5:CreateSlider({
   Name = "Player FOV",
   Range = {70, 120},
   Increment = 1,
   CurrentValue = 70,
   Callback = function(Value)
      workspace.CurrentCamera.FieldOfView = Value
   end,
})

-- Loop để giữ Speed không bị game reset khi hồi sinh
task.spawn(function()
    while task.wait() do
        pcall(function()
            if game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
                game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = _G.Speed
            end
        end)
    end
end)
