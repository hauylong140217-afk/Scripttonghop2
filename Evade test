-- [HỆ THỐNG XỬ LÝ CHÍNH]
RunService.PostSimulation:Connect(function()
    pcall(function()
        local char = lp.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            -- Fix Speed (Dùng CFrame bù vận tốc)
            if Config.Speed > 16 and hum.MoveDirection.Magnitude > 0 then
                char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + (hum.MoveDirection * (Config.Speed / 120))
            end
            
            -- Bhop
            if Config.Bhop and UserInputService:IsKeyDown(Enum.KeyCode.Space) and hum.FloorMaterial ~= Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)
end)

-- Vòng lặp quét ESP và Auto Respawn
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            if Config.ESP_Nextbot then
                for _, v in pairs(workspace.Game.Nextbots:GetChildren()) do
                    if v:FindFirstChild("HumanoidRootPart") then
                        CreateESP(v.HumanoidRootPart, v.Name, Color3.fromRGB(255, 0, 0))
                    end
                end
            end
            if Config.ESP_Player then
                for _, v in pairs(game.Players:GetPlayers()) do
                    if v ~= lp and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                        CreateESP(v.Character.HumanoidRootPart, v.Name, Color3.fromRGB(0, 255, 0))
                    end
                end
            end
            if Config.AutoRespawn and lp.Character.Humanoid.Health <= 0 then
                game:GetService("ReplicatedStorage").Events.Respawn:FireServer()
            end
        end)
    end
end)
