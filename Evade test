RunService.PreRender:Connect(function()
    pcall(function()
        local char = lp.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        
        if hrp and hum then
            -- Speed Bypass
            if Config.Speed > 16 and hum.MoveDirection.Magnitude > 0 then
                local vel = hum.MoveDirection * Config.Speed
                hrp.Velocity = Vector3.new(vel.X, hrp.Velocity.Y, vel.Z)
            end
            -- Auto Jump
            if Config.AutoJump and UIS:IsKeyDown(Config.JumpKey) then
                if hum.FloorMaterial ~= Enum.Material.Air then
                    hrp.Velocity = Vector3.new(hrp.Velocity.X, Config.JumpCap, hrp.Velocity.Z)
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
            -- Inf Stamina (Simple Evade Bypass)
            if Config.InfStamina then
                lp.PlayerGui.HUD.Stamina.Value = 100
            end
            -- No Camera Shake
            if Config.NoCameraShake and lp.PlayerGui:FindFirstChild("CameraShake") then
                lp.PlayerGui.CameraShake.Enabled = false
            end
        end
    end)
end)

-- Auto Revive & Respawn Loop
task.spawn(function()
    while task.wait(0.3) do
        if Config.AutoRevive then
            for _, v in pairs(game.Players:GetPlayers()) do
                if v ~= lp and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health <= 0 then
                    -- Giả lập bấm F3 để cứu đồng đội
                    game:GetService("ReplicatedStorage").Events.Revive:FireServer(v)
                end
            end
        end
        if Config.AutoRespawn and lp.Character and lp.Character:FindFirstChild("Humanoid") and lp.Character.Humanoid.Health <= 0 then
            game:GetService("ReplicatedStorage").Events.Respawn:FireServer()
        end
    end
end)

