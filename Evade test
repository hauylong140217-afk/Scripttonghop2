-- Hàm tạo ESP Tên gọn nhẹ
local function CreateESP(part, name, color)
    if not part or part:FindFirstChild("KenESP") then return end
    local bgui = Instance.new("BillboardGui", part)
    bgui.Name = "KenESP"
    bgui.AlwaysOnTop = true
    bgui.Size = UDim2.new(0, 200, 0, 50)
    bgui.ExtentsOffset = Vector3.new(0, 3, 0)
    
    local nametag = Instance.new("TextLabel", bgui)
    nametag.Text = name
    nametag.Size = UDim2.new(1, 0, 1, 0)
    nametag.BackgroundTransparency = 1
    nametag.TextColor3 = color
    nametag.TextStrokeTransparency = 0
    nametag.Font = Enum.Font.SourceSansBold
    nametag.TextSize = 14
end

