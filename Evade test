-- LOOP THỰC THI (QUAN TRỌNG ĐỂ SCRIPT HOẠT ĐỘNG)
task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                -- Apply Speed
                char.Humanoid.WalkSpeed = Config.Speed
                -- Apply Jump
                char.Humanoid.JumpPower = Config.JumpCap * Config.JumpMulti
                -- Auto Respawn Logic
                if Config.AutoRespawn and char.Humanoid.Health <= 0 then
                    game:GetService("ReplicatedStorage").Events.Respawn:FireServer()
                end
                -- Bhop Logic
                if _G.Bhop and game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) then
                    char.Humanoid.Jump = true
                end
            end
        end)
    end
end)
