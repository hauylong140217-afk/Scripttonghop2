   Name = "ESP Nextbots",
   CurrentValue = false,
   Flag = "ESPToggle",
   Callback = function(v)
      _G.ESPBots = v
      while _G.ESPBots do
         for _, bot in pairs(workspace.Game.Nextbots:GetChildren()) do
            if not bot:FindFirstChild("Highlight") then
               local hl = Instance.new("Highlight", bot)
               hl.FillColor = Color3.fromRGB(255, 0, 0)
            end
         end
         task.wait(1)
      end
   end,
})

