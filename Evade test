RunService.PreRender:Connect(function()
    pcall(function()
        local char = lp.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        
        if hrp and hum then
            -- Speed Bypass
            if Config.Speed > 16 and hum.MoveDirection.Magnitude > 0 then
                local vel = hum.MoveDirection * Config.Speed
                hrp.Velocity = Vector3.new(vel.X, hrp.Velocity.Y, vel.Z)
            end
            -- Auto Jump
            if Config.AutoJump and UIS:IsKeyDown(Config.JumpKey) then
                if hum.FloorMaterial ~= Enum.Material.Air then
                    hrp.Velocity = Vector3.new(hrp.Velocity.X, Config.JumpCap, hrp.Velocity.Z)
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
            -- Bounce
            if Config.Bounce and hum.FloorMaterial == Enum.Material.Air and hrp.Velocity.Y < 0 then
                hrp.Velocity = Vector3.new(hrp.Velocity.X, Config.BounceAmt, hrp.Velocity.Z)
            end
            -- No Camera Shake
            if Config.NoCameraShake then
                lp.PlayerGui.Scripts.CameraShake.Enabled = false
            end
        end
    end)
end)

-- ESP 
local function CreateESP(part, name, color)
    if not part or part:FindFirstChild("KenESP") then return end
    local bgui = Instance.new("BillboardGui", part); bgui.Name = "KenESP"; bgui.AlwaysOnTop = true; bgui.Size = UDim2.new(0, 200, 0, 50); bgui.ExtentsOffset = Vector3.new(0, 3, 0)
    local nametag = Instance.new("TextLabel", bgui); nametag.Text = name; nametag.Size = UDim2.new(1, 0, 1, 0); nametag.BackgroundTransparency = 1; nametag.TextColor3 = color; nametag.Font = Enum.Font.SourceSansBold; nametag.TextSize = 14
end

task.spawn(function()
    while task.wait(0.5) do
        if Config.ESP_Nextbot then
            for _, v in pairs(workspace.Game.Nextbots:GetChildren()) do CreateESP(v:FindFirstChild("HumanoidRootPart"), v.Name, Color3.fromRGB(255, 0, 0)) end
        end
        if Config.ESP_Player then
            for _, v in pairs(game.Players:GetPlayers()) do
                if v ~= lp and v.Character then CreateESP(v.Character:FindFirstChild("HumanoidRootPart"), v.Name, Color3.fromRGB(0, 255, 0)) end
            end
        end
        if Config.AutoRespawn and lp.Character and lp.Character:FindFirstChild("Humanoid") and lp.Character.Humanoid.Health <= 0 then
            game:GetService("ReplicatedStorage").Events.Respawn:FireServer()
        end
    end
end)
