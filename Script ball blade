-- Services
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LP = Players.LocalPlayer
local Char = LP.Character or LP.CharacterAdded:Wait()
local HRP = Char:WaitForChild("HumanoidRootPart")
local PlayerGui = LP:WaitForChild("PlayerGui")

-- Safe Remotes
local Remotes
for i=1,50 do
	Remotes = RS:FindFirstChild("Remotes")
	if Remotes then break end
	task.wait(0.1)
end
if not Remotes then warn("Remotes missing") return end

local ParryRemote = Remotes:FindFirstChild("ParryAttempt")
local AttackRemote = Remotes:FindFirstChild("Attack")
if not ParryRemote or not AttackRemote then warn("Parry/Attack missing") return end

-- ================= SETTINGS =================
local Settings = {
	AutoParry = true,
	AutoSpam = true,
	NoRender = true,
	Humanizer = true,
	ParryDistance = 85,
	PredictionBias = 0.028,
	BaseCD = 0.22,
	SpamDelay = 0.16,
	lastParry = 0,
	lastSpam = 0
}

-- ================= UTILS =================
local function Rand(a,b)
	if not Settings.Humanizer then return a end
	return a + math.random()*(b-a)
end

local function GetBall()
	for _,v in pairs(workspace:GetChildren()) do
		if v:IsA("BasePart") and v.Name:lower():find("ball") then return v end
	end
end

local function IsTargeted(ball)
	local vel = ball.AssemblyLinearVelocity or ball.Velocity
	if not vel then return false end
	local dir = (HRP.Position - ball.Position).Unit
	return vel.Unit:Dot(dir) > 0.6
end

-- ================= AUTO PARRY =================
RunService.Heartbeat:Connect(function()
	if not Settings.AutoParry then return end
	local ball = GetBall()
	if not ball then return end
	if (ball.Position - HRP.Position).Magnitude > Settings.ParryDistance then return end
	if not IsTargeted(ball) then return end
	if tick()-Settings.lastParry < Rand(Settings.BaseCD,Settings.BaseCD+0.04) then return end
	Settings.lastParry = tick()
	pcall(function() ParryRemote:FireServer() end)
end)

-- ================= AUTO SPAM =================
RunService.Heartbeat:Connect(function()
	if not Settings.AutoSpam then return end
	if tick()-Settings.lastSpam < Rand(Settings.SpamDelay,Settings.SpamDelay+0.05) then return end
	if not GetBall() then return end
	Settings.lastSpam = tick()
	pcall(function() AttackRemote:FireServer() end)
end)

-- ================= NO RENDER =================
RunService.Heartbeat:Connect(function()
	if not Settings.NoRender then return end
	for _,v in pairs(workspace:GetDescendants()) do
		if v:IsA("BasePart") and not v:IsDescendantOf(Char) then
			v.LocalTransparencyModifier = 1
		end
	end
end)

-- ================= UI =================
local ScreenGui = Instance.new("ScreenGui", PlayerGui)
ScreenGui.Name = "kencute24HubUI"

local Tabs = {"⚔ Combat","⚙ Advanced","🧊 Render","ℹ Info"}
local Frames = {}

-- Create Frames for Tabs
for i,tabName in ipairs(Tabs) do
	local frame = Instance.new("Frame", ScreenGui)
	frame.Name = tabName
	frame.Size = UDim2.new(0,200,0,300)
	frame.Position = UDim2.new(0,10,0,50)
	frame.BackgroundColor3 = Color3.fromRGB(15,76,200) -- Blue background
	frame.Visible = (i==1)
	Frames[tabName] = frame
end

-- Create Tab Buttons
for i,tabName in ipairs(Tabs) do
	local btn = Instance.new("TextButton", ScreenGui)
	btn.Size = UDim2.new(0,80,0,30)
	btn.Position = UDim2.new(0,10+((i-1)*85),0,10)
	btn.Text = tabName
	btn.BackgroundColor3 = Color3.fromRGB(0,120,255) -- Blue button
	btn.TextColor3 = Color3.fromRGB(255,255,255)
	btn.MouseButton1Click:Connect(function()
		for name,frame in pairs(Frames) do
			frame.Visible = (name == tabName)
		end
	end)
end

-- Helper functions to create Toggle / Slider
local function createToggle(parent,text,settingKey,posY)
	local btn = Instance.new("TextButton", parent)
	btn.Size = UDim2.new(0,150,0,30)
	btn.Position = UDim2.new(0,10,0,posY)
	btn.Text = text.." : "..tostring(Settings[settingKey])
	btn.BackgroundColor3 = Color3.fromRGB(50,150,255) -- Blue toggle
	btn.TextColor3 = Color3.fromRGB(255,255,255)
	btn.MouseButton1Click:Connect(function()
		Settings[settingKey] = not Settings[settingKey]
		btn.Text = text.." : "..tostring(Settings[settingKey])
	end)
end

local function createSlider(parent,text,settingKey,posY,min,max)
	local label = Instance.new("TextLabel", parent)
	label.Text = text.." : "..Settings[settingKey]
	label.Size = UDim2.new(0,150,0,20)
	label.Position = UDim2.new(0,10,0,posY)
	label.BackgroundColor3 = Color3.fromRGB(0,80,200)
	label.TextColor3 = Color3.fromRGB(255,255,255)

	local slider = Instance.new("TextButton", parent)
	slider.Size = UDim2.new(0,150,0,20)
	slider.Position = UDim2.new(0,10,0,posY+20)
	slider.BackgroundColor3 = Color3.fromRGB(0,120,255)
	slider.Text = ""
	local dragging = false

	slider.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
		end
	end)
	slider.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	RunService.RenderStepped:Connect(function()
		if dragging then
			local mouse = Players.LocalPlayer:GetMouse()
			local x = math.clamp(mouse.X - slider.AbsolutePosition.X,0,slider.AbsoluteSize.X)
			local value = min + (x/slider.AbsoluteSize.X)*(max-min)
			Settings[settingKey] = value
			label.Text = text.." : "..math.floor(value*100)/100
		end
	end)
end

