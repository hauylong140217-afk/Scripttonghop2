local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Window = Rayfield:CreateWindow({
	Name = "kencute24 Hub",
	LoadingTitle = "kencute24",
	LoadingSubtitle = "Dead Rails",
	ConfigurationSaving = {
		Enabled = false
	},
	KeySystem = false -- ❌ KHÔNG KEY
})

---------------------------------------------------
-- 👁 ESP
---------------------------------------------------
local ESPTab = Window:CreateTab("👁 ESP", 4483362458)

local ESPEnabled = false
local ESPObjects = {}

local function ClearESP()
	for _,v in pairs(ESPObjects) do
		if v then v:Remove() end
	end
	ESPObjects = {}
end

local function CreateESP(model, color)
	local text = Drawing.new("Text")
	text.Size = 13
	text.Center = true
	text.Outline = true
	text.Color = color
	table.insert(ESPObjects, text)

	RunService.RenderStepped:Connect(function()
		if not ESPEnabled or not model or not model:FindFirstChild("HumanoidRootPart") then
			text.Visible = false
			return
		end
		local pos, onscreen = Camera:WorldToViewportPoint(model.HumanoidRootPart.Position)
		if onscreen then
			local dist = math.floor((Camera.CFrame.Position - model.HumanoidRootPart.Position).Magnitude)
			text.Position = Vector2.new(pos.X, pos.Y)
			text.Text = model.Name .. " [" .. dist .. "m]"
			text.Visible = true
		else
			text.Visible = false
		end
	end)
end

ESPTab:CreateToggle({
	Name = "ESP Player + Distance",
	CurrentValue = false,
	Callback = function(v)
		ESPEnabled = v
		ClearESP()
		if v then
			for _,plr in pairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and plr.Character then
					CreateESP(plr.Character, Color3.fromRGB(0,255,0))
				end
			end
		end
	end
})

ESPTab:CreateToggle({
	Name = "ESP NPC + Distance",
	CurrentValue = false,
	Callback = function(v)
		ESPEnabled = v
		ClearESP()
		if v then
			for _,npc in pairs(workspace:GetDescendants()) do
				if npc:IsA("Model") and npc:FindFirstChild("Humanoid") then
					CreateESP(npc, Color3.fromRGB(255,0,0))
				end
			end
		end
	end
})

